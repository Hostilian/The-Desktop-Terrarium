<Window x:Class="Terrarium.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Terrarium - God Simulator"
        WindowState="Normal"
        Width="600"
        Height="450"
        ShowActivated="True"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Closing="Window_Closing"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Topmost="True">

    <Window.Resources>
        <!-- Clean, minimal styling inspired by WorldBox -->
        <SolidColorBrush x:Key="PanelBackground" Color="#DD000000"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#AA333333"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#CC444444"/>
        <SolidColorBrush x:Key="TextColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFAA00"/>

        <Style x:Key="CleanButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Canvas - Full screen background -->
        <Canvas x:Name="RenderCanvas" Background="Transparent" MouseLeftButtonDown="RenderCanvas_MouseLeftButtonDown"/>

        <!-- Top Resource Bar -->
        <Border Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="10"
                Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Time Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayPauseButton" Content="⏸️" ToolTip="Play/Pause Simulation" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="PlayPauseButton_Click" AutomationProperties.Name="Play Pause Simulation" AutomationProperties.HelpText="Toggle simulation playback" IsTabStop="True"/>
                    <Button x:Name="SpeedButton" Content="1x" ToolTip="Simulation Speed" Style="{StaticResource CleanButton}" Width="50" Height="40" Click="SpeedButton_Click" AutomationProperties.Name="Simulation Speed" AutomationProperties.HelpText="Change simulation speed multiplier" IsTabStop="True"/>
                </StackPanel>

                <!-- Population Bars -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="FactionPopulationPanel">
                    <!-- Faction populations will be added here dynamically -->
                    <TextBlock Text="Faction Populations" Foreground="{StaticResource TextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                </StackPanel>

                <!-- Minimap -->
                <Border Grid.Column="2" Background="#22000000" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" Width="120" Height="40" Margin="10,0">
                    <Canvas x:Name="MinimapCanvas" Background="Transparent"/>
                </Border>

                <!-- Performance Monitor -->
                <Border Grid.Column="3" Background="#22000000" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" Margin="10,0" Padding="5">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Performance" Foreground="{StaticResource TextColor}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FpsTextBlock" Text="FPS: --" Foreground="{StaticResource TextColor}" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MemoryTextBlock" Text="MEM: -- MB" Foreground="{StaticResource TextColor}" FontSize="9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Window Controls -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="⚙️" ToolTip="Settings" Style="{StaticResource CleanButton}" Width="30" Height="30" Click="SettingsButton_Click" AutomationProperties.Name="Settings" AutomationProperties.HelpText="Open settings dialog" IsTabStop="True"/>
                    <Button Content="📊" ToolTip="Statistics" Style="{StaticResource CleanButton}" Width="30" Height="30" Click="StatsButton_Click" AutomationProperties.Name="Statistics" AutomationProperties.HelpText="View simulation statistics" IsTabStop="True"/>
                    <Button Content="📜" ToolTip="Chronicle" Style="{StaticResource CleanButton}" Width="30" Height="30" Click="ChronicleButton_Click" AutomationProperties.Name="Chronicle" AutomationProperties.HelpText="View event chronicle" IsTabStop="True"/>
                    <Button Content="❌" ToolTip="Close" Style="{StaticResource CleanButton}" Width="30" Height="30" Click="CloseButton_Click" AutomationProperties.Name="Close Application" AutomationProperties.HelpText="Close the application" IsTabStop="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- God Powers Toolbar - Bottom -->
        <Border x:Name="GodPowersBorder" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="10"
                Height="80">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Creation Powers -->
                    <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                        <TextBlock Text="Creation" Foreground="{StaticResource AccentColor}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🌱" ToolTip="Spawn Plant" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="SpawnPlantButton_Click" AutomationProperties.Name="Spawn Plant" AutomationProperties.HelpText="Create a new plant at random location" IsTabStop="True"/>
                            <Button Content="🐰" ToolTip="Spawn Herbivore" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="SpawnHerbivoreButton_Click" AutomationProperties.Name="Spawn Herbivore" AutomationProperties.HelpText="Create a new herbivore creature" IsTabStop="True"/>
                            <Button Content="🐺" ToolTip="Spawn Carnivore" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="SpawnCarnivoreButton_Click" AutomationProperties.Name="Spawn Carnivore" AutomationProperties.HelpText="Create a new carnivore creature" IsTabStop="True"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Destruction Powers -->
                    <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                        <TextBlock Text="Destruction" Foreground="#FF4444" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⚡" ToolTip="Lightning Strike" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="LightningStrikeButton_Click" AutomationProperties.Name="Lightning Strike" AutomationProperties.HelpText="Strike random creatures with lightning" IsTabStop="True"/>
                            <Button Content="☄️" ToolTip="Meteor Shower" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="MeteorShowerButton_Click" AutomationProperties.Name="Meteor Shower" AutomationProperties.HelpText="Rain meteors on the world" IsTabStop="True"/>
                            <Button Content="💀" ToolTip="Plague" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="PlagueButton_Click" AutomationProperties.Name="Plague" AutomationProperties.HelpText="Spread disease among creatures" IsTabStop="True"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Blessing Powers -->
                    <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                        <TextBlock Text="Blessing" Foreground="#44FF44" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🌸" ToolTip="Fertility Blessing" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="FertilityBlessingButton_Click" AutomationProperties.Name="Fertility Blessing" AutomationProperties.HelpText="Increase reproduction rates" IsTabStop="True"/>
                            <Button Content="🍎" ToolTip="Abundance" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="AbundanceButton_Click" AutomationProperties.Name="Abundance" AutomationProperties.HelpText="Increase food availability" IsTabStop="True"/>
                            <Button Content="🛡️" ToolTip="Divine Protection" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="DivineProtectionButton_Click" AutomationProperties.Name="Divine Protection" AutomationProperties.HelpText="Heal all creatures to full health" IsTabStop="True"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Curse Powers -->
                    <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                        <TextBlock Text="Curse" Foreground="#FF4444" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🏜️" ToolTip="Famine" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="FamineButton_Click" AutomationProperties.Name="Famine" AutomationProperties.HelpText="Reduce food availability temporarily" IsTabStop="True"/>
                            <Button Content="😵" ToolTip="Madness" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="MadnessButton_Click" AutomationProperties.Name="Madness" AutomationProperties.HelpText="Cause creatures to move erratically" IsTabStop="True"/>
                            <Button Content="🕳️" ToolTip="Stagnation" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="StagnationButton_Click" AutomationProperties.Name="Stagnation" AutomationProperties.HelpText="Freeze all creatures in place" IsTabStop="True"/>
                            <Button Content="💪" ToolTip="Weakness" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="WeaknessButton_Click" AutomationProperties.Name="Weakness" AutomationProperties.HelpText="Reduce creatures' health" IsTabStop="True"/>
                            <Button Content="😈" ToolTip="Corruption" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="CorruptionButton_Click" AutomationProperties.Name="Corruption" AutomationProperties.HelpText="Corrupt creatures' behavior" IsTabStop="True"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Environment Powers -->
                    <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                        <TextBlock Text="Environment" Foreground="#4444FF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🏔️" ToolTip="Change Biome" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="ChangeBiomeButton_Click" AutomationProperties.Name="Change Biome" AutomationProperties.HelpText="Cycle through different biomes" IsTabStop="True"/>
                            <Button Content="🌤️" ToolTip="Change Season" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="ChangeSeasonButton_Click" AutomationProperties.Name="Change Season" AutomationProperties.HelpText="Cycle through seasons" IsTabStop="True"/>
                            <Button Content="🌊" ToolTip="Flood" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="FloodButton_Click" AutomationProperties.Name="Flood" AutomationProperties.HelpText="Flood the world with water" IsTabStop="True"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Painting Powers -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Painting" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🌱" ToolTip="Paint Life (Growth)" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="PaintLifeButton_Click" AutomationProperties.Name="Paint Life" AutomationProperties.HelpText="Paint to create life" IsTabStop="True"/>
                            <Button Content="💀" ToolTip="Paint Death (Void)" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="PaintDeathButton_Click" AutomationProperties.Name="Paint Death" AutomationProperties.HelpText="Paint to destroy life" IsTabStop="True"/>
                            <Button Content="🪨" ToolTip="Paint Stone" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="PaintStoneButton_Click" AutomationProperties.Name="Paint Stone" AutomationProperties.HelpText="Paint stone terrain" IsTabStop="True"/>
                            <Button Content="🌊" ToolTip="Paint Water" Style="{StaticResource CleanButton}" Width="40" Height="40" Click="PaintWaterButton_Click" AutomationProperties.Name="Paint Water" AutomationProperties.HelpText="Paint water terrain" IsTabStop="True"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Notification Area -->
        <StackPanel x:Name="NotificationPanel" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10,80,10,0"/>
    </Grid>
</Window>
